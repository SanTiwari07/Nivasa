# Copy to frontend/.env.local and adjust.

# Backend base URL. Leave empty in development: Vite proxies /api to http://127.0.0.1:8000.
# VITE_API_BASE_URL=https://api.example.com

# Map tiles. OpenStreetMap's own tiles are for light development use only; use a tile
# provider (or your own tile server) in production and update the attribution to match.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
