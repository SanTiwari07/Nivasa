# Copy to backend/.env and adjust. Every setting is optional; defaults suit local development.

# NIVASA_ENVIRONMENT=development
# SQLite by default. For Postgres: postgresql+psycopg://user:password@host:5432/nivasa (install psycopg first)
# NIVASA_DATABASE_URL=sqlite:///./nivasa.db
# JSON list of allowed browser origins
# NIVASA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Demo listings are fictional. Turn them off once real listings exist.
# NIVASA_INCLUDE_DEMO_LISTINGS=true

# Enables /api/admin/* for reviewing submitted listings. Leave unset to keep admin disabled.
# NIVASA_ADMIN_API_KEY=

# Geocoding: nominatim | none. Nominatim needs an identifying User-Agent with contact details.
# NIVASA_GEOCODER=nominatim
# NIVASA_NOMINATIM_URL=https://nominatim.openstreetmap.org
# NIVASA_NOMINATIM_USER_AGENT=Nivasa/0.1 (your-email@example.com)

# Routing: estimate (offline, straight line x detour factor) | osrm
# NIVASA_ROUTING_PROVIDER=estimate
# NIVASA_OSRM_URL=https://router.project-osrm.org
# NIVASA_DETOUR_FACTOR=1.3

# Cost assumptions (see docs/METHODOLOGY.md)
# NIVASA_MESS_MONTHLY_ESTIMATE=2900
# NIVASA_METRO_STUDENT_CONCESSION=0.30
# NIVASA_PETROL_COST_PER_KM=2.4
# NIVASA_COLLEGE_DAYS_PER_MONTH=24
